# База данных PostgreSQL
# Для локальной разработки БЕЗ Docker (npm run dev + своя Postgres) — оставьте так:
DATABASE_URL="postgresql://user:password@localhost:5432/med_abort_db?schema=public"
# При запуске через docker-compose переменная DATABASE_URL переопределяется
# автоматически на основе POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB ниже
# (см. docker-compose.yml) — эти три переменные нужны именно для контейнера БД.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="med_abort_db"

# Админ-панель (скрытый URL) — не публичные, только для сервера
ADMIN_PANEL_UUID="a7f3b2c1-d4e5-6789-abcd-ef0123456789"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe123456!"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Email (SMTP) — для отправки заявок
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="password"
CONTACT_EMAIL="info@example.com"

# Telegram-уведомления о заявках (опционально)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# S3-совместимое хранилище изображений.
# Продакшен: реальный S3 (например, Timeweb Cloud) — заполните все 4 поля.
# Локальная разработка: можно поднять MinIO из docker-compose
# (`docker compose --profile local-s3 up minio`) и указать:
#   S3_ENDPOINT="http://localhost:9000"
#   S3_BUCKET="med-abort-images" (создать бакет через консоль MinIO :9001)
S3_ENDPOINT="https://s3.timeweb.cloud"
S3_BUCKET="med-abort-images"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ru-1"

# Публичные контактные данные сайта (отображаются в UI, в т.ч. на клиенте)
NEXT_PUBLIC_SITE_PHONE="+78001234567"
NEXT_PUBLIC_SITE_EMAIL="info@example.com"
NEXT_PUBLIC_SITE_TELEGRAM="https://t.me/example"
NEXT_PUBLIC_SITE_WHATSAPP="https://wa.me/78001234567"
NEXT_PUBLIC_SITE_ADDRESS="Адрес будет указан позднее"

# Юридические реквизиты-заглушки (отображаются в футере)
NEXT_PUBLIC_SITE_INN="0000000000"
NEXT_PUBLIC_SITE_OGRN="0000000000000"
NEXT_PUBLIC_SITE_LEGAL_NAME="ООО «МедИнформ» (заглушка)"

# Яндекс.Метрика
NEXT_PUBLIC_YANDEX_METRIKA_ID=""

# URL сайта
NEXT_PUBLIC_SITE_URL="https://example.com"

# Docker: образ приложения (используется docker-compose.yml на проде для
# `docker compose pull` готового образа из GitHub Container Registry вместо
# пересборки на сервере). Для локальной разработки можно не задавать —
# сработает `docker compose build` с этими же именем/тегом по умолчанию.
IMAGE_NAME="ghcr.io/spyser177/site-project-1"
IMAGE_TAG="latest"

# Payload CMS 3 — установлен поверх существующей Prisma-админки.
# PAYLOAD_SECRET: сгенерируйте случайную строку, например:
#   openssl rand -hex 32
PAYLOAD_SECRET="change-me-to-a-long-random-string"
# PAYLOAD_ADMIN_SEGMENT: секретный префикс маршрутов Payload (UI и REST API).
# НЕ /admin — этот путь уже занят старой скрытой админкой (см. ADMIN_PANEL_UUID
# выше) и явно блокируется в next.config.ts/middleware.ts. Сгенерируйте свой:
#   openssl rand -hex 10
PAYLOAD_ADMIN_SEGMENT="cms-change-me"
