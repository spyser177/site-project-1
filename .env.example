# База данных PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/med_abort_db?schema=public"

# Админ-панель (скрытый URL) — не публичные, только для сервера
ADMIN_PANEL_UUID="a7f3b2c1-d4e5-6789-abcd-ef0123456789"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe123456!"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Email (SMTP) — для отправки заявок
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="password"
CONTACT_EMAIL="info@example.com"

# Telegram-уведомления о заявках (опционально)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# S3-совместимое хранилище (Timeweb Cloud) — итерация 2
S3_ENDPOINT="https://s3.timeweb.cloud"
S3_BUCKET="med-abort-images"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ru-1"

# Публичные контактные данные сайта (отображаются в UI, в т.ч. на клиенте)
NEXT_PUBLIC_SITE_PHONE="+78001234567"
NEXT_PUBLIC_SITE_EMAIL="info@example.com"
NEXT_PUBLIC_SITE_TELEGRAM="https://t.me/example"
NEXT_PUBLIC_SITE_WHATSAPP="https://wa.me/78001234567"
NEXT_PUBLIC_SITE_ADDRESS="Адрес будет указан позднее"

# Юридические реквизиты-заглушки (отображаются в футере)
NEXT_PUBLIC_SITE_INN="0000000000"
NEXT_PUBLIC_SITE_OGRN="0000000000000"
NEXT_PUBLIC_SITE_LEGAL_NAME="ООО «МедИнформ» (заглушка)"

# Яндекс.Метрика
NEXT_PUBLIC_YANDEX_METRIKA_ID=""

# URL сайта
NEXT_PUBLIC_SITE_URL="https://example.com"
