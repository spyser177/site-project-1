generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Заявки с контактной формы
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  message   String
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Дополнительные статьи, управляемые из админ-панели
model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  content     String   @default("")
  imageUrl    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
}

// Настройки сайта (редактируемые тексты)
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@index([key])
}

// Попытки входа в админ-панель (для защиты от перебора)
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// Администраторы
model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
